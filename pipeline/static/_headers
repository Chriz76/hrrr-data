# Cloudflare Pages: Response-Header fuer die statisch ausgelieferten Wind-Tiles.
#
# Wird von pipeline.py automatisch in das Deploy-Verzeichnis kopiert
# (ensure_headers_file) und muss dort im ROOT liegen, weil wrangler das ganze
# Verzeichnis hochlaedt:  npx wrangler pages deploy ./output --project-name winddata
#
# ---------------------------------------------------------------------------
# 1) Tile-Dateien: tiles/<timestamp>/<z>/<x>/<y>.bin
# ---------------------------------------------------------------------------
# Die Dateien liegen BEREITS gzip-komprimiert auf der Platte (der komplette
# Tile-Payload in EINEM gzip-Strom). Cloudflare erkennt das NICHT an der Endung -
# es gibt keine Dateiendung, die automatisch "Content-Encoding: gzip" setzt (auch
# ".gz" nicht: das liefert nur Content-Type: application/gzip, der Browser
# entpackt dann nichts). Deshalb hier explizit setzen.
#
# Wirkung: der Browser entpackt die Antwort transparent. Im JS ist
#   const buf = await (await fetch(url)).arrayBuffer();
# damit automatisch der DEKOMPRIMIERTE Tile-Inhalt:
#   [Geo-Header 24B][u_len 4B][v_len 4B][u_int16][v_int16]
#
# Pruefen:  curl -sI https://<projekt>.pages.dev/tiles/<ts>/7/20/51.bin
#   -> HTTP/2 200
#      content-encoding: gzip
#      content-type: application/octet-stream
#
# CACHING: vorerst komplett AUS (no-store), damit kalte Reads unverfaelscht
# gemessen werden koennen. Ein blosses Weglassen des Cache-Control-Headers wuerde
# NICHT reichen: Pages schickt dann seinen Default ("max-age=0, must-revalidate"
# + ETag) und der Browser revalidiert per 304 -> kein echter Transfer, aber auch
# kein kalter Read. no-store verhindert Browser- UND Edge-Cache.
# Spaeter (fuer Produktion) wieder ersetzen durch:
#   Cache-Control: public, max-age=31536000, immutable, no-transform
#
# no-transform ist PFLICHT, solange vor-komprimiert wird:
# Cloudflare Pages komprimiert die Antwort NAEMLICH TROTZDEM zusaetzlich, obwohl
# hier schon Content-Encoding: gzip steht. Gemessen: Datei 14067 B -> 14081 B auf
# der Leitung; der Client entpackt einmal und haelt danach gzip-Muell in der Hand.
# RFC 9111 (Cache) verbietet einem Intermediary bei "no-transform" genau das.
# Verifikation nach dem Deploy:
#   curl -sS -H 'Accept-Encoding: gzip' --raw -o /tmp/wire.bin \
#        -w 'wire=%{size_download}\n' <TILE_URL>
#   -> muss die Dateigroesse von der Platte sein (z.B. 14067), nicht 14081.
/tiles/*
  Content-Encoding: gzip
  Content-Type: application/octet-stream
  Access-Control-Allow-Origin: *
  Cache-Control: no-store, no-transform
  X-Content-Type-Options: nosniff

# ---------------------------------------------------------------------------
# 2) Metadaten pro Zeitstempel: meta/<timestamp>.json
# ---------------------------------------------------------------------------
# ACHTUNG: liegt bewusst NICHT unter /tiles/, weil dort alles als gzip
# deklariert wird. Diese Dateien sind unkomprimiertes JSON.
# Caching ebenfalls aus (Messphase, siehe oben).
/meta/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# ---------------------------------------------------------------------------
# 3) Index mit den verfuegbaren Zeitstempeln: /index.json
# ---------------------------------------------------------------------------
# Caching ebenfalls aus (Messphase, siehe oben).
/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
